---
import { Font } from 'astro:assets'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config/site'
import '../styles/global.css'

interface Props {
    /** Page-specific title, joined onto the site name. Omit for the home page. */
    title?: string
    /** Overrides the default site tagline for this page's meta description. */
    description?: string
}

const { title, description = SITE_TAGLINE } = Astro.props

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="canonical" href={canonicalUrl} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#0F0C0A" />
        <Font cssVariable="--font-fraunces" preload />
        <Font cssVariable="--font-cinzel" preload />
        <Font cssVariable="--font-cormorant" preload />
        <Font cssVariable="--font-unifraktur" />
    </head>
    <body>
        <SiteHeader />
        <main class="shell">
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
