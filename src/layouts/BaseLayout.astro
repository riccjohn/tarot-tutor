---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config/site'
import '../styles/global.css'

interface Props {
    /** Page-specific title, joined onto the site name. Omit for the home page. */
    title?: string
    /** Overrides the default site tagline for this page's meta description. */
    description?: string
}

const { title, description = SITE_TAGLINE } = Astro.props

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="canonical" href={canonicalUrl} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Source+Sans+3:wght@300;400;600&family=DM+Mono:wght@400&display=swap"
        />
    </head>
    <body>
        <SiteHeader />
        <main>
            <slot />
        </main>
        <SiteFooter />
    </body>
</html>
