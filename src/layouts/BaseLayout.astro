---
import { SITE_NAME, SITE_TAGLINE, SITE_URL } from '../config/site'
import '../styles/global.css'

interface Props {
    /** Page-specific title, joined onto the site name. Omit for the home page. */
    title?: string
    /** Overrides the default site tagline for this page's meta description. */
    description?: string
}

const { title, description = SITE_TAGLINE } = Astro.props

const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL)
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <meta name="generator" content={Astro.generator} />
        <link rel="canonical" href={canonicalUrl} />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
    </head>
    <body>
        <main>
            <slot />
        </main>
    </body>
</html>
