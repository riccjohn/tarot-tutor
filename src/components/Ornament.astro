---
/**
 * Decorative alchemical/engraving glyphs, ported from the direction-A
 * mockup's shared `<symbol>` defs. Inlined per-instance (rather than
 * `<use href="#id">` against a single sprite) so each usage is a
 * self-contained, testable component with no page-level sprite dependency.
 *
 * Purely decorative: `aria-hidden` and `focusable="false"` always, no
 * `<title>`, no text content. Colour comes from `currentColor`, set by
 * whatever CSS rule styles the containing `[data-testid="ornament"]`.
 */
export interface Props {
    kind: 'corner' | 'wands' | 'cups' | 'swords' | 'pentacles' | 'hero'
    class?: string
}

const { kind, class: className } = Astro.props

const VIEWBOX: Record<Props['kind'], string> = {
    corner: '0 0 20 20',
    wands: '0 0 32 32',
    cups: '0 0 32 32',
    swords: '0 0 32 32',
    pentacles: '0 0 32 32',
    hero: '0 0 200 200',
}
---

<svg
    data-testid="ornament"
    class={className}
    viewBox={VIEWBOX[kind]}
    aria-hidden="true"
    focusable="false"
>
    {kind === 'corner' && (
        <>
            <path
                d="M1 19V6a5 5 0 0 1 5-5h13M5 19V9a4 4 0 0 1 4-4h10"
                fill="none"
                stroke="currentColor"
                stroke-width="1"
            />
            <circle cx="4" cy="4" r="1.6" fill="currentColor" />
        </>
    )}
    {kind === 'wands' && (
        <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
        >
            <path d="M16 3v26" />
            <path d="M16 9c-3-1-4-3-4-5M16 14c3-1 4-3 4-5M16 20c-3-1-4-3-4-5" />
        </g>
    )}
    {kind === 'cups' && (
        <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
        >
            <path d="M8 5h16c0 7-3 11-8 11S8 12 8 5Z" />
            <path d="M16 16v9M11 28h10M12 25h8" />
        </g>
    )}
    {kind === 'swords' && (
        <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
            stroke-linecap="round"
        >
            <path d="M16 2l2 4v15h-4V6Z" />
            <path d="M10 21h12M16 21v6" />
            <circle cx="16" cy="29" r="1.5" />
        </g>
    )}
    {kind === 'pentacles' && (
        <g fill="none" stroke="currentColor" stroke-width="1.2">
            <circle cx="16" cy="16" r="13" />
            <path
                d="M16 4.5 22.8 25.3 5 12.4H27L9.2 25.3Z"
                stroke-linejoin="round"
            />
        </g>
    )}
    {kind === 'hero' && (
        <g fill="none" stroke="currentColor" stroke-width=".6">
            <circle cx="100" cy="100" r="96" />
            <circle cx="100" cy="100" r="90" />
            <circle cx="100" cy="100" r="60" />
            <circle cx="100" cy="100" r="20" />
            <path d="M100 10 177.9 145 22.1 145Z" />
            <path d="M100 190 22.1 55 177.9 55Z" />
            <path
                d="M100 4v192M4 100h192M32 32l136 136M168 32 32 168"
                stroke-dasharray="1 3"
            />
        </g>
    )}
</svg>
