---
import { SITE_NAME } from '../config/site'

/**
 * The site's only navigation: a wordmark and two destinations, on one line
 * at every width so it costs as little height as possible above the cards.
 */

const links = [
    { href: '/', label: 'Cards' },
    { href: '/draw/', label: 'Draw' },
]

/** `/` must match exactly, or it would claim every page. */
const path = Astro.url.pathname
const isCurrent = (href: string) =>
    href === '/' ? path === '/' : path.startsWith(href)
---

<header class="site-header shell">
    <a class="site-header__mark" href="/">
        {SITE_NAME}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
        {links.map((link) => (
            <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
                {link.label}
            </a>
        ))}
    </nav>
</header>

<style>
    .site-header {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        padding-block: 0.9rem 0.5rem;
    }

    .site-header__mark {
        font-family: var(--font-display);
        font-style: italic;
        font-size: 1.35rem;
        line-height: 1;
        letter-spacing: -0.01em;
        color: var(--color-accent);
        text-decoration: none;
    }

    .site-header__nav {
        display: flex;
        gap: 1.25rem;
    }

    .site-header__nav a {
        font-family: var(--font-label);
        font-size: 0.72rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-muted);
        text-decoration: none;
        padding-block: 0.2rem;
        border-bottom: 1px solid transparent;
        transition:
            color 0.25s var(--ease-brand),
            border-color 0.25s var(--ease-brand);
    }

    .site-header__nav a:hover {
        color: var(--color-ink);
    }

    .site-header__nav a[aria-current='page'] {
        color: var(--color-ink);
        border-bottom-color: var(--color-accent);
    }
</style>
