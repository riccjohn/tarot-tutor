---
import CardFrame from './CardFrame.astro'
import CardImage from './CardImage.astro'
import { suitOf, type Card } from '../lib/deck'
import { toRoman } from '../lib/ornament'

/**
 * Renders one spread's card slots on a CSS grid driven by the abstract
 * `x`/`y` coordinates from `src/lib/spreads.ts` (Phase 8's geometry source
 * of truth). This component never redefines or re-derives geometry — it
 * only consumes the coordinates it's handed.
 *
 * Each slot links out to the drawn card's own page (`/cards/{id}/`) rather
 * than inlining card content, per the Phase 9 contract.
 *
 * Mobile-first: below the breakpoint the grid collapses to a single
 * vertical column, in the same source order the slots were given in, so
 * position labels and their order survive the reflow even on the
 * five-card cross (the widest layout, 3x3 grid units).
 *
 * The field the slots sit on ("altar cloth") and the faint line linking
 * them in position order are decorative only — the real information is
 * the slot geometry itself (`--slot-column`/`--slot-row`, `data-x`/
 * `data-y`), never re-derived from the drawn line — so the connecting
 * `<svg>` is `aria-hidden` and skipped outright for a one-position spread.
 * Each placeholder frames its card with `CardFrame`, the same component
 * the card detail page uses, so a spread slot reads as the same engraved
 * plate as everywhere else in the deck.
 */

export interface SpreadLayoutSlot {
    /** This position's name, e.g. "Past". */
    label: string
    /** This position's prose meaning, from the spreads content collection. */
    meaning: string
    /** Abstract grid coordinates, from `src/lib/spreads.ts`. */
    x: number
    y: number
    /** The card drawn for this position. */
    card: Card
    reversed: boolean
}

export interface Props {
    slots: SpreadLayoutSlot[]
}

const { slots } = Astro.props

/** Maps one coordinate onto a 0-100 percent point for the connecting line. */
function linePercent(value: number, max: number): number {
    return max > 0 ? (value / max) * 100 : 50
}

const maxX = Math.max(...slots.map((slot) => slot.x))
const maxY = Math.max(...slots.map((slot) => slot.y))
const linePoints = slots
    .map((slot) => `${linePercent(slot.x, maxX)},${linePercent(slot.y, maxY)}`)
    .join(' ')
---

<div class="spread-layout">
    {slots.length > 1 && (
        <svg
            class="spread-layout__geometry"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            aria-hidden="true"
            focusable="false"
        >
            <polyline points={linePoints} fill="none" stroke="currentColor" />
        </svg>
    )}
    {slots.map((slot, index) => (
        <div
            class="spread-layout__slot"
            data-testid="spread-position"
            data-x={slot.x}
            data-y={slot.y}
            data-card-id={slot.card.id}
            data-reversed={String(slot.reversed)}
            style={`--slot-column: ${slot.x + 1}; --slot-row: ${slot.y + 1};`}
        >
            <p class="spread-layout__label eyebrow">
                <span class="spread-layout__index" aria-hidden="true">
                    {toRoman(index + 1)}
                </span>
                {slot.label}
            </p>
            <a data-testid="spread-card-link" href={`/cards/${slot.card.id}/`}>
                <CardFrame suit={suitOf(slot.card) ?? 'major'}>
                    <CardImage
                        id={slot.card.id}
                        name={slot.card.name}
                        variant="thumb"
                    />
                </CardFrame>
                <span class="spread-layout__name">{slot.card.name}</span>
            </a>
            {/*
                Generic framing, identical for every reversed card, matching
                `DailyDraw.tsx`'s reversal-note and `FreePull.tsx`'s
                reversal-badge. Without it a reversed card in a spread reads
                as upright, which contradicts how the same draw is presented
                on the other two surfaces. Never card-specific text — there
                is no per-card reversed meaning anywhere in the payload.
            */}
            {slot.reversed && (
                <p data-testid="spread-reversal-note">
                    Reversed — read the same meaning turned inward or blocked,
                    not a different card.
                </p>
            )}
            <p class="spread-layout__meaning">{slot.meaning}</p>
        </div>
    ))}
</div>

<style>
    /*
     * The altar cloth: a sunken radial field the slots sit on, echoing
     * `CardFrame`/`CardBack`'s own engraved-plate treatment at page scale.
     */
    .spread-layout {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1.75rem 1.25rem;
        margin-block: 2.5rem 3rem;
        padding: clamp(1.25rem, 4vw, 2.5rem);
        background: radial-gradient(
            ellipse at center,
            var(--color-paper-sunk),
            var(--color-paper) 70%
        );
        border: 1px solid var(--color-border);
    }

    /*
     * A faint line through the positions in slot order — the geometry's
     * own shape, never a separate decoration invented here. Sits behind
     * the slots (`.spread-layout__slot` below is `z-index: 1`).
     */
    .spread-layout__geometry {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        color: var(--color-accent-soft);
        opacity: 0.4;
        pointer-events: none;
    }

    .spread-layout__slot a {
        display: block;
        text-decoration: none;
    }

    /*
     * `CardFrame` already carries its own engraved-plate look (mat, gilt
     * hairline, drop shadow, corner ornaments) from global.css — this
     * component only adds the hover lift, targeting the frame's root via
     * `:global()` because it is a separate component instance and never
     * carries `SpreadLayout`'s own scope attribute.
     */
    .spread-layout__slot :global([data-testid='card-frame']) {
        transition:
            transform 0.4s var(--ease-brand),
            box-shadow 0.4s var(--ease-brand);
    }

    .spread-layout__slot a:hover :global([data-testid='card-frame']) {
        transform: translateY(-3px);
    }

    .spread-layout__name {
        display: block;
        font-family: var(--font-display);
        font-size: 1.05rem;
        color: var(--color-ink);
        letter-spacing: -0.01em;
        margin-top: 0.6rem;
    }

    .spread-layout__slot a:hover .spread-layout__name {
        color: var(--color-accent);
    }

    .spread-layout__label {
        position: relative;
        z-index: 1;
        margin-bottom: 0.5rem;
    }

    /* Roman numeral folio, the same decorative device as the deck index
     * and the card detail page's symbol walkthrough (`toRoman`). */
    .spread-layout__index {
        margin-right: 0.5em;
        color: var(--color-accent);
    }

    .spread-layout__meaning {
        font-size: 0.9rem;
        color: var(--color-ink-soft);
        margin-top: 0.5rem;
    }

    .spread-layout__slot {
        position: relative;
        z-index: 1;
        grid-column: var(--slot-column);
        grid-row: var(--slot-row);
    }

    @media (max-width: 480px) {
        .spread-layout {
            display: flex;
            flex-direction: column;
        }

        .spread-layout__geometry {
            display: none;
        }

        .spread-layout__slot {
            grid-column: auto;
            grid-row: auto;
        }
    }
</style>
