---
import type { PieceStatus } from '../lib/content/compose'

export interface Props {
    status: PieceStatus
}

const { status } = Astro.props
---

{status === 'draft' && (
    <p data-testid="draft-badge">
        Draft — this reading is still being written and may change.
    </p>
)}

<style>
    /*
     * Honest, not alarming. Draft status is the norm across most of the site
     * right now, so a loud warning colour would shout on nearly every page.
     * A quiet amber rule reads as a note from the author.
     */
    p {
        display: inline-block;
        margin-block: 0 1.75rem;
        padding: 0.4rem 0.75rem 0.4rem 0.7rem;
        border-left: 2px solid var(--color-draft);
        background-color: oklch(0.586 0.106 62 / 0.07);
        color: var(--color-ink-soft);
        font-size: 0.85rem;
        max-width: none;
    }
</style>
