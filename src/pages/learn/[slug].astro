---
/**
 * One beginner-track lesson page.
 *
 * `getStaticPaths` reads `getCollection('learn')`, sorts by the declared
 * `order` field to compute `prev`/`next` (null at each end), and renders
 * each entry's markdown to an HTML string for `bodyHtml`.
 *
 * The HTML comes straight off `entry.rendered.html`, which Astro's loader
 * has already produced — no `astro/container` in the build path.
 *
 * Learn entries are currently frontmatter-only drafts, so `learn-body`
 * renders empty in the built pages today. That is missing prose, not a
 * broken pipeline: adding a markdown body to an entry renders it
 * correctly (verified).
 */

import { getCollection, render } from 'astro:content'
import DraftBadge from '../../components/DraftBadge.astro'
import BaseLayout from '../../layouts/BaseLayout.astro'

export interface LearnEntryNavLink {
    slug: string
    title: string
}

export interface LearnEntryView {
    slug: string
    title: string
    description: string
    status: 'draft' | 'edited'
    /** Pre-rendered body markup for this lesson. */
    bodyHtml: string
}

export interface Props {
    entry: LearnEntryView
    /** `null` when this is the first entry in declared order. */
    prev: LearnEntryNavLink | null
    /** `null` when this is the last entry in declared order. */
    next: LearnEntryNavLink | null
}

export async function getStaticPaths() {
    const learnEntries = await getCollection('learn')
    const sorted = [...learnEntries].sort((a, b) => a.data.order - b.data.order)

    const views: LearnEntryView[] = await Promise.all(
        sorted.map(async (entry) => {
            // Astro's loader already renders each entry's markdown and hands
            // back the HTML on `entry.rendered`. Reaching for that is both
            // cheaper and stabler than rendering `<Content />` through
            // `astro/container`, which is an experimental testing API that
            // has no business running in a production build path.
            const bodyHtml = entry.rendered?.html ?? ''
            return {
                slug: entry.id,
                title: entry.data.title,
                description: entry.data.description,
                status: entry.data.status,
                bodyHtml,
            }
        })
    )

    return views.map((view, index) => ({
        params: { slug: view.slug },
        props: {
            entry: view,
            prev:
                index > 0
                    ? {
                          slug: views[index - 1]!.slug,
                          title: views[index - 1]!.title,
                      }
                    : null,
            next:
                index < views.length - 1
                    ? {
                          slug: views[index + 1]!.slug,
                          title: views[index + 1]!.title,
                      }
                    : null,
        },
    }))
}

const { entry, prev, next } = Astro.props
---

<BaseLayout title={entry.title} description={entry.description}>
    <DraftBadge status={entry.status} />
    <h1 data-testid="learn-title">{entry.title}</h1>
    <p data-testid="learn-description">{entry.description}</p>
    <div data-testid="learn-body" set:html={entry.bodyHtml} />
    <nav>
        {prev && (
            <a data-testid="learn-prev-link" href={`/learn/${prev.slug}/`}>
                {prev.title}
            </a>
        )}
        {next && (
            <a data-testid="learn-next-link" href={`/learn/${next.slug}/`}>
                {next.title}
            </a>
        )}
    </nav>
</BaseLayout>
