---
import { getCollection } from 'astro:content'
import DailyDraw from '../components/islands/DailyDraw'
import FreePull from '../components/islands/FreePull'
import {
    composeCard,
    type ComposedCard,
    type ContentCollections,
} from '../lib/content/compose'
import { DECK } from '../lib/deck'
import { localDateKey } from '../lib/draw'
import BaseLayout from '../layouts/BaseLayout.astro'

/**
 * Today's card, then a free pull underneath.
 *
 * `DailyDraw` takes the raw collections (plain `{ id, data }` entries, which
 * survive Astro's island prop serialization) and composes inside the island.
 * `FreePull` can't take a `compose` function across that boundary, so the
 * whole deck is composed here once and handed over as a lookup.
 */
const [cards, suits, numbers, ranks, majorsArc] = await Promise.all([
    getCollection('cards'),
    getCollection('suits'),
    getCollection('numbers'),
    getCollection('ranks'),
    getCollection('majorsArc'),
])

const collections: ContentCollections = {
    cards,
    suits,
    numbers,
    ranks,
    majorsArc,
}

const composedById: Record<string, ComposedCard> = {}
for (const card of DECK) {
    composedById[card.id] = composeCard(card, collections)
}

const dateKey = localDateKey()
---

<BaseLayout title="Draw">
    <section class="draw-section">
        <DailyDraw dateKey={dateKey} collections={collections} client:idle />
    </section>

    <section class="draw-section">
        <p class="eyebrow">Free pull</p>
        <h2>Pull as many as you like</h2>
        <FreePull composedById={composedById} client:idle />
    </section>
</BaseLayout>

<style>
    /* `overflow-x: clip` keeps the card's candle halo from widening the page. */
    .draw-section {
        text-align: center;
        display: grid;
        justify-items: center;
        overflow-x: clip;
    }

    .draw-section + .draw-section {
        margin-top: 3rem;
        padding-top: 3rem;
        border-top: 1px solid var(--color-border);
    }

    .draw-section h2 {
        margin-top: 0;
    }
</style>
